     8	import re, sys, os, glob
     9	sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
    10	import v2_shell as V
    11	
    12	ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    13	EXCLUDE = {"reader.html", "insta.html"}   # insta = 링크 허브, nav/footer 없음
    14	HDR_LEGACY = re.compile(r'<header class="nav[^"]*">.*?</header>', re.S)
    15	
    16	
    17	def main():
    18	    skip = set(EXCLUDE); check = "--check" in sys.argv
    19	    for i, a in enumerate(sys.argv):
    20	        if a == "--skip": skip |= set(x for x in sys.argv[i + 1].split(",") if x)
    21	    changed = missing = legacy = 0
    22	    for path in sorted(glob.glob(os.path.join(ROOT, "**", "*.html"), recursive=True)):
    23	        rel = os.path.relpath(path, ROOT).replace(os.sep, "/")
    24	        if rel in skip or rel.startswith("programs/") or rel.startswith(("design/", "_design/", "_tools/")) or "/_" in "/" + rel: continue
    25	        s = open(path, encoding="utf-8").read()
    26	        if '<body class="v2' in s:
    27	            new = V.apply_shell(s, rel)
    28	            if not V.SHELL_RE.search(s): missing += 1; print("v2 셸 없음:", rel)
    29	        elif HDR_LEGACY.search(s):
    30	            legacy += 1; print("레거시 nav 잔존 (v2 전환 필요):", rel); continue
    31	        else:
    32	            missing += 1; print("nav 없음:", rel); continue
    33	        if new != s:
    34	            changed += 1
    35	            if not check: open(path, "w", encoding="utf-8").write(new)
    36	    print(f"{'변경 필요' if check else '변경'} {changed} / nav 없음 {missing} / 레거시 {legacy}")
    37	    return 1 if (check and changed) or legacy else 0

   274	def _sub_guarded(regex, maker, s, rel, name, max_span=20000):
   275	    """블록 교체 가드: 매치 0 = 무변경, 2+ = 실패(중복 셸 방지), 과대 스팬 = 정규식 과탐(본문 삼킴) 실패."""
   276	    # R2 발주에서 파일 무변경으로 지정한 면은 공용 셸도 기존 바이트를 유지한다.
   277	    if rel in {"404.html", "cart.html", "checkout.html", "join.html", "login.html", "my.html", "pay_done.html"}:
   278	        return s
   279	    ms = list(regex.finditer(s))
   280	    if not ms:
   281	        return s
   282	    if len(ms) > 1:
   283	        raise SystemExit(f"{rel}: {name} 블록/자리표시 {len(ms)}개, 1개만 허용 (중복 주입 위험)")
   284	    m = ms[0]
   285	    if m.end() - m.start() > max_span:
   286	        raise SystemExit(f"{rel}: {name} 매치 스팬 {m.end() - m.start()}B, 정규식이 본문을 삼킨 것으로 판단해 중단")
   287	    return s[:m.start()] + maker(rel) + s[m.end():]

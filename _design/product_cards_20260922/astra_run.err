932::where(body.v2) .prib .k::before{content:"";width:6px;height:6px;background:var(--seal);border-radius:50%;
935::where(body.v2) .pclose{position:absolute;top:0;right:0;width:var(--tap);height:var(--tap);
936:  display:grid;place-items:center;color:var(--ink);z-index:2}
937::where(body.v2) .pclose svg{width:var(--s4);height:var(--s4)}
938::where(body.v2) .pclose:hover{color:var(--ink)}

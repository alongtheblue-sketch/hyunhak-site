le":true},{"slug":"ewha","name":"이화여자대학교","short":"이화여자대","pages":36,"q":152,"sale":true},{"slug":"incheon","name":"인천대학교","short":"인천대","pages":43,"q":154,"sale":true},{"slug":"inha","name":"인하대학교","short":"인하대","pages":40,"q":148,"sale":true},{"slug":"cau","name":"중앙대학교","short":"중앙대","pages":39,"q":131,"sale":true},{"slug":"hufs","name":"한국외국어대학교","short":"한국외국어대","pages":36,"q":167,"sale":true},{"slug":"hanyang-erica","name":"한양대학교(ERICA)","short":"한양대(ERICA)","pages":17,"q":11,"sale":true}];
(function(){
  var box=document.getElementById('tiles'),tabs=document.querySelectorAll('.find .tabs [role=tab]'),q=document.getElementById('q2'),f='all',LIMIT=12;
  function tile(o){
    var st=o.sale?'<span class="p" data-list-price="33000">33,000원</span>':'<span class="w">준비 중</span>';
    return '<a class="tile'+(o.sale?'':' ready')+'" href="guidebook/'+o.slug+'.html"><span class="n">'+o.name.replace(/\(.*?\)/,'')+'<small>'+(o.name.match(/\((.*?)\)/)?o.name.match(/\((.*?)\)/)[1]:'')+'</small></span><span class="m">2027학년도 대비</span><span class="s">'+st+'</span></a>';
  }
  function render(){
    var kw=(q.value||'').trim();
    var list=HH_GB.filter(function(o){return (f==='all'||(f==='sale'&&o.sale))&&(!kw||o.name.indexOf(kw)>-1||o.short.indexOf(kw)>-1)});
    box.innerHTML=list.slice(0,LIMIT).map(tile).join('')||'<p class="empty">일치하는 대학이 없습니다. 가이드북 전체 목록에서 확인.</p>';
  }
  tabs.forEach(function(b){b.addEventListener('click',function(){tabs.forEach(function(x){x.setAttribute('aria-selected','false')});b.setAttribute('aria-selected','true');f=b.dataset.f;render()})});
  q.addEventListener('input',render); render();
  // 공지 3건 (API). 실패하거나 0건이면 공지 전체 링크만 남긴다
  var nr=document.getElementById('noticeRows');
  if(nr&&window.HH){HH.api('/api/notices?kind=notice&limit=3').then(function(data){
    var items=Array.isArray(data)?data:(data.notices||data.items||[]);if(!items.length)return;
    nr.innerHTML=items.map(function(it){var d=String(it.starts_at||it.created_at||'').slice(0,10);
      return '<li><a href="notice.html?id='+encodeURIComponent(it.id)+'"><span>'+HH.esc(it.title||'')+'</span><time datetime="'+d+'">'+d.replace(/-/g,'.')+'</time></a></li>'}).join('')}).catch(function(){})}
})();
</script>


1363::where(body.v2) .r3-hero .r2-intro{grid-area:intro;max-width:none;margin-inline:0;padding-top:var(--s3)}  /* 상단 s3: 계기 밴드 첫 화면 여유 확보 (2026-09-09 verify_r3 실측) */

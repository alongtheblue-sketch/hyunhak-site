1355::where(body.v2) .r3-hero{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);grid-template-areas:"intro intro" "buy visual" "buy metrics";column-gap:var(--s5);align-items:start;margin-bottom:var(--s4)}  /* 계기 밴드를 히어로 오른쪽 열(시각물 아래)에 두어 1280×800 첫 화면 안에 6칸 전부 (critic 재채점 수리 7, 2026-09-09) */

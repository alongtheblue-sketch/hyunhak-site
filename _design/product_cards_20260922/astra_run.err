949:  color:var(--gray);margin-top:var(--s2);max-width:none}
950::where(body.v2) .ptxt .pnote{margin-top:var(--s3);font-size:var(--t-sm);line-height:var(--lh-ui);color:var(--body);max-width:none}   /* 안내 한 줄 (2026-09-10 9/14 오픈). 마감 줄과 다른 층이라 mono 가 아니라 본문 small */
951::where(body.v2) .ptxt .pnote .tlink{margin-left:var(--s1);white-space:nowrap}

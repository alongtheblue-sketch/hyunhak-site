1411::where(body.v2) .r3-sample-gallery .r2-samples figure.pgv{margin:0;padding:var(--s3);border:var(--rule-ui);background:var(--card);display:grid;grid-template-rows:minmax(0,1fr) auto;align-items:center}  /* 이미지 세로 가운데, 캡션 아래 고정: 높이 차이가 카드 위아래 대칭 여백으로 (critic 2회차 수리 6) */  /* 높이가 다른 표본 카드를 같은 높이의 테두리 카드로: 빈 자리가 결함이 아니라 카드 안 여백으로 읽히게 (critic 수리 6) */

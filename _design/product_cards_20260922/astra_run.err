943::where(body.v2) .pkv .ph span{font-family:var(--mono);font-size:var(--t-xs);letter-spacing:var(--tr-label);color:var(--gray)}
944::where(body.v2) .pop--noimg .pkv{display:none}   /* 도판 없는 회차. 나머지 칸은 그대로 선다 */
946::where(body.v2) .ptxt h2{font-size:var(--t-h3)}

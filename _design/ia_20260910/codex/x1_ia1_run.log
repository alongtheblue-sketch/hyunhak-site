  function axNoteText(u){
    var first=u&&u.sets&&u.sets[0]&&u.sets[0].axes;
    if(!first) return '';
    var names=Object.keys(first).filter(function(k){ return k!=='합계'; }).map(function(k){ return axName(k,1); });
    if(!names.length) return '';

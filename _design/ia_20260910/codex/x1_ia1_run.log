  function cartMsg(text){
    var el=document.getElementById('cartMsg');
    if(!el) { if(text) alert(text); return; }
    el.textContent=text||'';
    el.hidden=!text;
  }
  document.getElementById('setMore').addEventListener('click', function(ev){

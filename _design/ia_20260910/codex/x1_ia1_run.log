    pub(cur).then(function(m){
      list.forEach(function(s){
        var el=tb.querySelector('[data-st="'+s.id+'"]'); if(!el) return;
        if(m===null){ el.textContent='상태 미상'; el.className='badge mute'; return; }
        var st=m[s.id];
        if(st==='ready'){ el.textContent='공개'; el.className='badge seal'; }
        else { el.textContent='준비 중'; el.className='badge mute'; }
      });
    });
  }
  function selectUnit(code, scroll){
    if(!okUnit(code)) return;   // 허용 단위 5종 밖은 무시한다 (Global 4 미래캠 포함)

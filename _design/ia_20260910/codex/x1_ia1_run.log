  // 화살표, Home, End 로 탭 이동 (선택과 초점이 함께 간다)
  document.getElementById('unitTabs').addEventListener('keydown', function(ev){
    var K={ArrowLeft:-1,ArrowRight:1,Home:'first',End:'last'}[ev.key];
    if(K===undefined) return;
    var list=Array.prototype.slice.call(this.children), i=list.indexOf(ev.target.closest('[data-unit]'));
    if(i<0) return;

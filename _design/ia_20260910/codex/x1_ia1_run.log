1:"""IA1 단위 명패: 소개면과 구매면 template의 마크업 원천 (런타임 층)."""
2:import html
3:import json
4:import re
5:from pathlib import Path
6:
7:from exam_pages import codes as EX
8:
9:HERE = Path(__file__).resolve().parent
10:
11:
12:def copy_text(key):
13:    return json.loads((HERE / "r2_copy.json").read_text(encoding="utf-8"))[key][0]
14:
15:
16:def units():
17:    rows = []
18:    for number, (code, label, _) in enumerate(EX.CODES, 1):
19:        spec = json.loads((HERE / "exam_pages" / "facts" / f"{code}.json").read_text(encoding="utf-8"))["spec"]
20:        if spec["status"] not in {"on_sale", "opening"}:
21:            raise ValueError(f"{code}: unknown status")
22:        uni = label.split(" ", 1)[0]
23:        # 예정 단위의 카드 표제는 IA1 §5 승인 문면을 그대로 사용한다.
24:        title = copy_text(code.replace("-", "_")) if spec["status"] == "opening" else label
25:        if not title.startswith(uni + " "):
26:            raise ValueError(f"{code}: university label mismatch")
27:        minutes = []
28:        for key in ("prep_sec", "answer_sec"):
29:            value = spec[key]
30:            if not isinstance(value, int) or value <= 0 or value % 60:
31:                raise ValueError(f"{code}: {key} must be whole minutes")
32:            minutes.append(value // 60)
33:        if spec["status"] == "opening":
34:            month, day = map(int, spec["open_date"].split("-")[1:])
35:            if f"{month}월 {day}일" != EX.OPEN_DATE:
36:                raise ValueError(f"{code}: opening date mismatch")
37:        rows.append(dict(code=code, number=f"{number:02}", uni=uni,
38:                         title=title[len(uni) + 1:], label=title, spec=spec,
39:                         prep=minutes[0], answer=minutes[1]))
40:    return rows
41:
42:
43:def card(row, prefix="../", purchase=False):
44:    esc = html.escape
45:    code = row["code"]
46:    opening = row["spec"]["status"] == "opening"
47:    badge = copy_text("r3_unit_opening" if opening else "r3_unit_on_sale")
48:    note = copy_text("r3_unit_open_note" if opening else "r3_30passages")
49:    specs = "".join(
50:        f'<div><dt>{esc(copy_text(key))}</dt><dd>{value}{esc(copy_text(unit))}</dd></div>'
51:        for key, value, unit in (("r3_unit_prep", row["prep"], "r3_unit_minutes"),
52:                                 ("r3_unit_answer", row["answer"], "r3_unit_minutes"),
53:                                 ("r3_unit_questions", row["spec"]["questions"], "r3_unit_count")))
54:    actions = (f'<a class="btn ghost sm" href="{prefix}interview/{code}.html">'
55:               f'{esc(copy_text("r3_unit_guide"))}</a>')
56:    if not opening:
57:        room_attr = f' data-unit-go="{code}"' if purchase else ""
58:        actions += (f'<a class="btn ghost sm" href="{prefix}studio.html?unit={code}"{room_attr}>'
59:                    f'{esc(copy_text("r3_room"))}</a>')
60:        actions += (f'<button type="button" class="tlink" data-r3-unit-cart>{esc(copy_text("add"))}</button>'
61:                    if purchase else f'<a class="tlink" href="#buy" data-r3-unit-buy="{code}">{esc(copy_text("add"))}</a>')
62:    return (f'<article class="unit r3-unit{" r3-unit-opening" if opening else ""}" id="u-{code}" data-r3-unit="{code}">'
63:            f'<span class="kn">{row["number"]}</span>'
64:            f'<div class="r3-unit-heading"><p class="uni">{esc(row["uni"])}</p>'
65:            f'<h3>{esc(row["title"])}</h3><span class="r3-unit-badge">{esc(badge)}</span></div>'
66:            f'<dl class="dl r3-unit-spec">{specs}</dl>'
67:            f'<p class="r3-unit-note">{esc(note)}</p>'
68:            '<div class="r3-unit-commerce"></div>'
69:            f'<div class="foot">{actions}</div></article>')
70:
71:
72:def render():
73:    return "\n".join(card(row) for row in units())
74:
75:
76:def sync_purchase(source):
77:    rows = units()
78:    cards = "\n".join(card(row, prefix="", purchase=True) for row in rows
79:                      if row["spec"]["status"] == "on_sale")
80:    upcoming = [row for row in rows if row["spec"]["status"] == "opening"]
81:    links = ", ".join(f'<a class="tlink" href="interview/{row["code"]}.html">{html.escape(row["label"])}</a>'
82:                      for row in upcoming)
83:    block = ('<!-- ia1:units:begin -->\n<template id="r3-unit-template">\n' + cards
84:             + '\n</template>\n<p class="note r3-opening-links">'
85:             + f'{EX.OPEN_DATE}에 여는 단위: {links}</p>\n<!-- ia1:units:end -->')
86:    source, count = re.subn(r'<!-- ia1:units:begin -->.*?<!-- ia1:units:end -->',
87:                            lambda _: block, source, flags=re.S)
88:    if count != 1:
89:        raise ValueError("studio.html: expected one IA1 units block")
90:    return source
